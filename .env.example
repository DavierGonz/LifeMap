# Configuracion de infraestructura local; sin contrasenas reales.
# Las contrasenas locales se guardan fuera de Git; no regenerar usuarios existentes.
# Kaggle: .secrets/kaggle-token.txt o .secrets/kaggle.json; nunca pegar aqui el valor.
COMPOSE_PROJECT_NAME=lifemap
MONGO_DATABASE=lifemap
API_PORT=5100
SPARK_UI_PORT=8082
DASK_UI_PORT=8788
JENKINS_PORT=8083
DEPLOYED_COMMIT=unreleased

# Rutas exclusivas de LifeMap. No apuntar a los proyectos protegidos.
MONGO_ROOT_PASSWORD_FILE=./.secrets/mongo_root_password.txt
MONGO_WRITER_PASSWORD_FILE=./.secrets/mongo_writer_password.txt
MONGO_READER_PASSWORD_FILE=./.secrets/mongo_reader_password.txt
